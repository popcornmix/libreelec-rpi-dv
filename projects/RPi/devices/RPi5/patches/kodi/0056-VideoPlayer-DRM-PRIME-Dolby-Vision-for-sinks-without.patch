+void CDVTunnelDRMPRIME::GetOutputPicture(const VideoPicture& picture,
+                                         pi_output_kind output,
+                                         VideoPicture& out)
+{
+  out.SetParams(picture);
+  out.color_range = 1;
+  if (output == PI_OUTPUT_SDR)
+  {
+    out.color_primaries = AVCOL_PRI_BT709;
+    out.color_transfer = AVCOL_TRC_BT709;
+    out.color_space = AVCOL_SPC_BT709;
+    out.hasDisplayMetadata = false;
+    out.hasLightMetadata = false;
+    return;
+  }
+
+  out.color_primaries = AVCOL_PRI_BT2020;
+  out.color_transfer = AVCOL_TRC_SMPTE2084;
+  out.color_space = AVCOL_SPC_BT2020_NCL;
+  if (out.hasDisplayMetadata && out.hasLightMetadata)
+    return;
+
+  auto* buffer = dynamic_cast<CVideoBufferDRMPRIMEFFmpeg*>(picture.videoBuffer);
+  const AVFrameSideData* side =
+      buffer ? av_frame_get_side_data(buffer->GetFrame(), AV_FRAME_DATA_DOVI_METADATA) : nullptr;
+  if (!side)
+    return;
+
+  const auto* metadata = reinterpret_cast<const AVDOVIMetadata*>(side->data);
+  const AVDOVIColorMetadata* colour = av_dovi_get_color(metadata);
+  const AVDOVIDmData* l6 = av_dovi_find_level(metadata, 6);
+  if (!out.hasDisplayMetadata)
+  {
+    // BT.2020 primaries and D65: Dolby Vision's LMS is BT.2020-referred
+    static constexpr int primaries[3][2] = {{35400, 14600}, {8500, 39850}, {6550, 2300}};
+    for (int i = 0; i < 3; i++)
+      for (int j = 0; j < 2; j++)
+        out.displayMetadata.display_primaries[i][j] = av_make_q(primaries[i][j], 50000);
+    out.displayMetadata.white_point[0] = av_make_q(15635, 50000);
+    out.displayMetadata.white_point[1] = av_make_q(16450, 50000);
+    if (l6 && l6->l6.max_luminance)
+    {
+      out.displayMetadata.max_luminance = av_make_q(l6->l6.max_luminance, 1);
+      out.displayMetadata.min_luminance = av_make_q(l6->l6.min_luminance, 10000);
+    }
+    else
+    {
+      const auto nits = [](int pq)
+      {
+        const double p = std::pow(pq / 4095.0, 32.0 / 2523.0);
+        return 10000.0 * std::pow(std::max(p - 3424.0 / 4096.0, 0.0) /
+                                      (2413.0 / 128.0 - 2392.0 / 128.0 * p),
+                                  16384.0 / 2610.0);
+      };
+      out.displayMetadata.max_luminance = av_d2q(nits(colour->source_max_pq), 100000);
+      out.displayMetadata.min_luminance = av_d2q(nits(colour->source_min_pq), 100000);
+    }
+    out.displayMetadata.has_primaries = 1;
+    out.displayMetadata.has_luminance = 1;
+    out.hasDisplayMetadata = true;
+  }
+  if (!out.hasLightMetadata && l6 && l6->l6.max_cll)
+  {
+    out.lightMetadata.MaxCLL = l6->l6.max_cll;
+    out.lightMetadata.MaxFALL = l6->l6.max_fall;
+    out.hasLightMetadata = true;
+  }
+}
