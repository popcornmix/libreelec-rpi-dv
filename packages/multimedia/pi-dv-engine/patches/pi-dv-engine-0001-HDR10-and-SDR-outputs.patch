+/* SDR's table (colour()): pre's colour scaled by the gain at its luminance */
+static void *colour_gain(void *arg)
+{
+    const struct colour_job *jb = arg;
+    _Float16 *t = jb->lut + (size_t)4 * LUT_N * LUT_N * jb->k0;
+    const float *pre = jb->pre + (size_t)4 * LUT_N * LUT_N * jb->k0, *g = jb->g;
+    for (int n = 0; n < LUT_N * LUT_N * (jb->k1 - jb->k0); n++, t += 4, pre += 4) {
+        int fi = (int)pre[3];
+        float f = pre[3] - (float)fi, gain = g[fi] + (g[fi + 1] - g[fi]) * f;
+        for (int c = 0; c < 3; c++)
+            t[c] = (_Float16)fminf(pre[c] * gain, 1.0f);
+        t[3] = (_Float16)1.0f;
+    }
+    return NULL;
+}
