+/* The display outputs' colour table for the frame's RPU: its colour metadata
+ * decoded (planner/pixel_colour.c) to BT.2020 linear light, for SDR the
+ * scene's L1 range mapped onto SDR's (BT.2390's EETF on the luminance) and
+ * BT.709, negatives desaturated into the gamut, and the transfer (PQ, or
+ * gamma 2.4). Rebuilt when the RPU's colour metadata or (SDR) L1 changes.
+ * SDR's gain scales all three channels and the desaturation alike, and its
+ * transfer is a power, so (o g)^(1/2.4) = o^(1/2.4) g^(1/2.4): o^(1/2.4) is
+ * kept per entry (pre), and an L1 change only rescales it. */
+static void colour(struct pi_engine *e, const AVDOVIMetadata *md)
+{
+    /* Dolby Vision's LMS is BT.2020-referred (libplacebo's dovi_lms2rgb) */
+    static const double lms_to_2020[9] = {3.06441879, -2.16597676, 0.10155818, -0.65612108, 1.78554118,
+                                          -0.12943749, 0.01736321, -0.04725154, 1.03004253};
+    static const double bt2020_to_709[9] = {1.660491, -0.587641, -0.072850, -0.124550, 1.132900,
+                                            -0.008349, -0.018151, -0.100579, 1.118730};
+    enum { STEPS = 1024 };
+    const AVDOVIColorMetadata *cm = av_dovi_get_color(md);
+    const AVDOVIDmData *l1 = av_dovi_find_level(md, 1);
+    const int sdr = e->output == PI_OUTPUT_SDR;
+    /* SDR: BT.2408's HDR reference white is SDR's peak */
+    const double white = 203.0;
+    double key[24];
+    for (int i = 0; i < 9; i++) {
+        key[i] = av_q2d(cm->ycc_to_rgb_matrix[i]);
+        key[9 + i] = av_q2d(cm->rgb_to_lms_matrix[i]);
+    }
+    for (int i = 0; i < 3; i++)
+        key[18 + i] = av_q2d(cm->ycc_to_rgb_offset[i]);
+    /* the scene's range: L1, else the mastering display's */
+    key[21] = sdr ? pq_linear((l1 ? l1->l1.min_pq : cm->source_min_pq) / 4095.0) * 10000.0 : 0.0;
+    key[22] = sdr ? pq_linear((l1 && l1->l1.max_pq ? l1->l1.max_pq : cm->source_max_pq) / 4095.0) * 10000.0 : 0.0;
+    key[23] = (double)e->output;
+    if (e->lut_serial && !memcmp(key, e->colour_key, sizeof(key)))
+        return;
+
+    double t0 = now_ms();
+    int decoded = e->pre_valid && !memcmp(key, e->colour_key, 21 * sizeof(double)) && key[23] == e->colour_key[23];
+    if (!decoded) {
+        double lin[9], out[9];
+        mul3(lms_to_2020, key + 9, lin);
+        if (sdr)
+            mul3(bt2020_to_709, lin, out);
+        else
+            memcpy(out, lin, sizeof(out));
+        /* the transfers, the encodings as tables of v^(1/4) */
+        float dec[STEPS + 1], enc[STEPS + 1];
+        for (int i = 0; i <= STEPS; i++) {
+            double v = pow((double)i / STEPS, 4.0);
+            dec[i] = (float)pq_linear((double)i / STEPS);
+            enc[i] = (float)(sdr ? pow(v, 1.0 / 2.4) : pq_code(v));
+        }
+        struct colour_job jobs[COLOUR_JOBS];
+        for (int k = 0; k < COLOUR_JOBS; k++)
+            jobs[k] = (struct colour_job){e->lut, e->pre, LUT_N * k / COLOUR_JOBS, LUT_N * (k + 1) / COLOUR_JOBS,
+                                          sdr, key, out, dec, enc, NULL};
+        colour_parallel(colour_decode, jobs);
+        e->pre_valid = sdr;
+    }
+    if (sdr) {
+        /* the gain^(1/2.4) as a table of y^(1/4) */
+        float g[STEPS + 2];
+        double b, w, max_lum;
+        eetf_range(key[21], fmax(key[22], white), white, &b, &w, &max_lum);
+        for (int i = 0; i <= STEPS; i++) {
+            double x = fmax(pow((double)i / STEPS, 4.0), 1e-12);
+            g[i] = (float)pow(eetf(x, b, w, max_lum, white) / x * 10000.0 / white, 1.0 / 2.4);
+        }
+        g[STEPS + 1] = g[STEPS];
+        struct colour_job jobs[COLOUR_JOBS];
+        for (int k = 0; k < COLOUR_JOBS; k++)
+            jobs[k] = (struct colour_job){e->lut, e->pre, LUT_N * k / COLOUR_JOBS, LUT_N * (k + 1) / COLOUR_JOBS,
+                                          sdr, NULL, NULL, NULL, NULL, g};
+        colour_parallel(colour_gain, jobs);
+    }
+    memcpy(e->colour_key, key, sizeof(key));
+    e->lut_serial++;
+    logf_(e, PI_LOG_DEBUG, "colour table %u made in %.1f ms%s", (unsigned)e->lut_serial, now_ms() - t0,
+          decoded ? " (gain only)" : "");
+}
