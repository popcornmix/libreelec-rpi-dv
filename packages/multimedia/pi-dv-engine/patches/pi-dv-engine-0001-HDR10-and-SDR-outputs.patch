 /* The frame's own Params over the generation's. */
+/* ---- the display outputs' colour ----------------------------------------------- */
+
+static double pq_linear(double v)   /* SMPTE ST 2084: 1 is 10000 nits */
+{
+    double p = pow(fmax(v, 0.0), 32.0 / 2523.0);
+    return pow(fmax(p - 3424.0 / 4096.0, 0.0) / (2413.0 / 128.0 - 2392.0 / 128.0 * p), 16384.0 / 2610.0);
+}
+
+static double pq_code(double y)
+{
+    double p = pow(fmax(y, 0.0), 2610.0 / 16384.0);
+    return pow((3424.0 / 4096.0 + 2413.0 / 128.0 * p) / (1.0 + 2392.0 / 128.0 * p), 2523.0 / 32.0);
+}
+
+static void mul3(const double a[9], const double b[9], double out[9])
+{
+    for (int i = 0; i < 3; i++)
+        for (int j = 0; j < 3; j++)
+            out[3 * i + j] = a[3 * i] * b[j] + a[3 * i + 1] * b[3 + j] + a[3 * i + 2] * b[6 + j];
+}
+
+/* BT.2390's EETF: luminance y (1: 10000 nits) of a scene from lb to lw nits,
+ * onto a display of 0 to peak nits; b, w and max_lum are eetf_range()'s. */
+static void eetf_range(double lb, double lw, double peak, double *b, double *w, double *max_lum)
+{
+    *b = pq_code(lb / 10000.0);
+    *w = pq_code(lw / 10000.0);
+    *max_lum = *w - *b < 1e-6 ? 0.0 : (pq_code(peak / 10000.0) - *b) / (*w - *b);
+}
+
+static double eetf(double y, double b, double w, double max_lum, double peak)
+{
+    if (w - b < 1e-6)
+        return fmin(y, peak / 10000.0);
+    double e1 = (pq_code(y) - b) / (w - b);
+    double ks = 1.5 * max_lum - 0.5, e2 = e1;
+    if (e1 > ks && ks < 1.0) {
+        double t = (e1 - ks) / (1.0 - ks), t2 = t * t, t3 = t2 * t;
+        e2 = (2 * t3 - 3 * t2 + 1) * ks + (t3 - 2 * t2 + t) * (1.0 - ks) + (-2 * t3 + 3 * t2) * max_lum;
+    }
+    return pq_linear(fmax(e2, 0.0) * (w - b) + b);
+}
+
+/* t, a table of n + 1 steps over [0, 1] of v^(1/4), at v */
+static double quartic(const float *t, int n, double v)
+{
+    double f = sqrt(sqrt(fmin(fmax(v, 0.0), 1.0))) * n;
+    int i = (int)f < n ? (int)f : n - 1;
+    return t[i] + (t[i + 1] - t[i]) * (f - i);
+}
+
+/* colour()'s table work in COLOUR_JOBS slices of its k planes: one on the
+ * calling thread, the others on threads of their own */
+enum { COLOUR_JOBS = 4 };
+
+struct colour_job {
+    _Float16 *lut;
+    float *pre;
+    int k0, k1, sdr;
+    const double *key, *out;
+    const float *dec, *enc, *g;
+};
+
+static void colour_parallel(void *(*fn)(void *), struct colour_job *jobs)
+{
+    pthread_t th[COLOUR_JOBS];
+    int started[COLOUR_JOBS] = {0};
+    for (int k = 1; k < COLOUR_JOBS; k++)
+        started[k] = !pthread_create(&th[k], NULL, fn, &jobs[k]);
+    fn(&jobs[0]);
+    for (int k = 1; k < COLOUR_JOBS; k++) {
+        if (started[k])
+            pthread_join(th[k], NULL);
+        else
+            fn(&jobs[k]);
+    }
+}
+
+/* the stream's part of the table (colour()): the colour decoded, desaturated
+ * and, for HDR10, encoded; for SDR its encoding before the gain, kept in pre */
+static void *colour_decode(void *arg)
+{
+    enum { STEPS = 1024 };
+    static const double luma[2][3] = {{0.2627, 0.6780, 0.0593}, {0.2126, 0.7152, 0.0722}};
+    const struct colour_job *jb = arg;
+    const double *key = jb->key, *out = jb->out;
+    const float *dec = jb->dec, *enc = jb->enc;
+    const int sdr = jb->sdr;
+    _Float16 *t = jb->lut + (size_t)4 * LUT_N * LUT_N * jb->k0;
+    float *pre = jb->pre + (size_t)4 * LUT_N * LUT_N * jb->k0;
+    for (int k = jb->k0; k < jb->k1; k++)
+        for (int j = 0; j < LUT_N; j++)
+            for (int i = 0; i < LUT_N; i++, t += 4, pre += 4) {
+                double sig[3] = {(double)i / (LUT_N - 1) - key[18], (double)j / (LUT_N - 1) - key[19],
+                                 (double)k / (LUT_N - 1) - key[20]};
+                double l[3], o[3];
+                for (int c = 0; c < 3; c++) {
+                    double n = fmin(fmax(key[3 * c] * sig[0] + key[3 * c + 1] * sig[1] + key[3 * c + 2] * sig[2], 0.0), 1.0);
+                    double f = n * STEPS;
+                    int fi = (int)f < STEPS ? (int)f : STEPS - 1;
+                    l[c] = dec[fi] + (dec[fi + 1] - dec[fi]) * (f - fi);
+                }
+                for (int c = 0; c < 3; c++)
+                    o[c] = out[3 * c] * l[0] + out[3 * c + 1] * l[1] + out[3 * c + 2] * l[2];
+                double y = fmax(luma[sdr][0] * o[0] + luma[sdr][1] * o[1] + luma[sdr][2] * o[2], 0.0);
+                double lo = fmin(o[0], fmin(o[1], o[2]));
+                for (int c = 0; c < 3; c++) {
+                    if (lo < 0.0)
+                        o[c] = y + (o[c] - y) * (y / fmax(y - lo, 1e-12));
+                    if (sdr)
+                        pre[c] = (float)quartic(enc, STEPS, o[c]);
+                    else
+                        t[c] = (_Float16)quartic(enc, STEPS, o[c]);
+                }
+                pre[3] = (float)(sqrt(sqrt(fmin(y, 1.0))) * STEPS);
+                t[3] = (_Float16)1.0f;
+            }
+    return NULL;
+}
